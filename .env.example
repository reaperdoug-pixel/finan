# Modelo. Copie para .env no servidor/dev e preencha lá. Nunca coloque valores reais aqui.
# Apenas a API lê estas variáveis; o front-end não recebe nenhuma.
API_PORT=3000
# Segredo do servidor para proteger tokens de sessão (mínimo 32 caracteres aleatórios).
SESSION_SECRET=
# Origem pública do front-end, usada na checagem de Origin (CSRF).
APP_ORIGIN=http://localhost:5173
# Proxies cujo X-Forwarded-For é aceito (IPs/CIDRs separados por vírgula).
# Vazio = só loopback (127.0.0.1 e ::1), o Caddy na mesma máquina. Nunca use "true" ou "*".
TRUST_PROXY=
# Papel da API (finan_app): só SELECT/INSERT/UPDATE, log só SELECT/INSERT.
DATABASE_URL=
# Papel dono (finan_owner): usado só para rodar migrações.
MIGRATE_DATABASE_URL=
# Banco de testes (nunca aponte para produção).
TEST_DATABASE_URL=
TEST_MIGRATE_DATABASE_URL=
