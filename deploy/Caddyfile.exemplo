# Modelo do Caddy para a VPS (tarefa 15). Troque o domínio e o caminho do build.
# O Caddy serve o front (web/dist) e repassa /api para a API em 127.0.0.1:3000,
# sem o prefixo /api, como o proxy do Vite faz em desenvolvimento.
# A API já envia nosniff, X-Frame-Options, Referrer-Policy e Cache-Control: no-store.
# A CSP e o HSTS da página ficam aqui, porque o front é servido pelo Caddy.

finan.exemplo.com.br {
	encode zstd gzip

	header {
		# HSTS: só depois de confirmar que o HTTPS está firme em todo o domínio.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Tudo vem do próprio domínio: sem scripts, fontes ou imagens de terceiros.
		# style-src-attr 'unsafe-inline' libera apenas atributos style="..." usados nos gráficos
		# e recuos dinâmicos do React, mantendo <style> inline bloqueado por style-src 'self'.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# O reverse_proxy envia X-Forwarded-For com o IP real do cliente (substitui o que vier
	# de fora, pois o cliente não é um trusted_proxy do Caddy). A API só aceita esse
	# cabeçalho quando a conexão vem de loopback (TRUST_PROXY, padrão 127.0.0.1 e ::1).
	handle_path /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /srv/finan/web/dist
		try_files {path} /index.html
		file_server
	}
}
